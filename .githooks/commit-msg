#!/bin/sh
# Message hygiene guard -- rejects label-free commit messages ("changes", "wip",
# "checkpoint ..."), which are what make parallel-session sweep commits unrecoverable.
# Rules and the DAIL_ALLOW_LOOSE_MSG=1 override live in tools/check_commit_hygiene.py.
# Enable on a fresh clone (one-time): git config core.hooksPath .githooks

for PY in .venv/Scripts/python.exe .venv/Scripts/python .venv/bin/python python3 python; do
  command -v "$PY" >/dev/null 2>&1 && break
done

"$PY" tools/check_commit_hygiene.py --commit-msg "$1"
