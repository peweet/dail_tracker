+def _etag(response: Any) -> str | None:
+    """Read an S3 ETag from either the operation response or HTTP metadata."""
+    if not isinstance(response, dict):
+        return None
+    value = response.get("ETag")
+    if value is None:
+        metadata = response.get("ResponseMetadata")
+        headers = metadata.get("HTTPHeaders") if isinstance(metadata, dict) else None
+        value = headers.get("etag") if isinstance(headers, dict) else None
+    return str(value) if value else None
