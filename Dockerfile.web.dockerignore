# Whitelist build context for the web (Streamlit) image — BuildKit reads this
# file because it sits next to Dockerfile.web. Same discipline as .dockerignore
# (the API image): exclude everything, re-include only what Dockerfile.web
# COPYs, because a local working tree carries multi-GB untracked artefacts.

*

# build inputs
!pyproject.toml
!uv.lock
!paths.py
!config.py
!.streamlit/

# code + the SQL view firewall
!utility/
!dail_tracker_core/
!sql_views/
!sql_queries/
!services/

# data: ONLY the directories the registered views read (kept in sync with
# .dockerignore — the API image's whitelist — and with
# `grep -rhoE "data/[A-Za-z0-9_./-]+" sql_views/`).
!data/gold/parquet/
!data/_meta/
!data/silver/parquet/
!data/silver/charities/
!data/silver/committees/
!data/silver/cro/
!data/silver/lobbying/parquet/
!data/silver/lobbying/client_company_returns_detail.csv
!data/silver/aggregated_td_tables.csv
!data/silver/seanad_aggregated_tables.csv
!data/silver/flattened_members.csv
!data/silver/flattened_seanad_members.csv
!data/silver/ministerial_tenure.parquet

# big untracked artefacts that live inside whitelisted dirs
data/gold/parquet/speeches_fact_full.parquet
data/_export_cache/
**/__pycache__/
