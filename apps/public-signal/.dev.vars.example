# Copy to .dev.vars for local development. Never commit the real values.
RESEND_API_KEY=re_replace_me
RESEND_DOMAIN_VERIFIED=false
EMAIL_FROM=PublicSignal <alerts@publicsignal.ie>
EMAIL_REPLY_TO=hello@publicsignal.ie
ADMIN_API_KEY=replace-with-a-long-random-value
PROCUREMENT_FEED_TOKEN=
# Enables the labelled sample fallback for local development only.
PUBLIC_SIGNAL_ENV=local
# Local-only placeholder. Replace with a random value for local testing; never use this value in production.
ANALYTICS_HASH_SALT=local-only-placeholder-do-not-use-in-production
SNAPSHOT_MAX_AGE_HOURS=48
