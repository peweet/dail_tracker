{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "public-signal",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-05",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "public-signal",
      "database_id": "bafe7412-de1d-4d71-9b18-52f8b7b3b833",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "SUBSCRIPTION_LIMITER",
      "namespace_id": "801503",
      "simple": {
        "limit": 3,
        "period": 60
      }
    },
    {
      "name": "ANALYTICS_LIMITER",
      "namespace_id": "801504",
      "simple": {
        "limit": 100,
        "period": 60
      }
    }
  ],
  "triggers": {
    "crons": ["10 7 * * MON-FRI"]
  },
  "vars": {
    "APP_URL": "https://publicsignal.ie",
    "EMAIL_FROM": "PublicSignal <alerts@publicsignal.ie>",
    "PROCUREMENT_FEED_URL": "",
    "ANALYTICS_RETENTION_DAYS": "90"
  },
  // publicsignal.ie is purchased but was not yet present in the .IE registry on
  // 2026-08-05. Once the zone is active in Cloudflare, uncomment and deploy:
  // "routes": [
  //   {
  //     "pattern": "publicsignal.ie",
  //     "custom_domain": true
  //   }
  // ],
  "observability": {
    "enabled": true
  }
}
