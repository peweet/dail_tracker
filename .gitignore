# === Legal Diary raw daily DOCX archive — NEVER commit ===
# pdf_infra/legal_diary_poller.py archives the Courts Service daily diary under
# data/bronze/legal_diary/<date>.docx. The raw file names PRIVATE parties (minors,
# wards, criminal defendants) in full — only the ANONYMISED gold parquet
# (judicial_legal_diary_cases.parquet, initials only) may ever leave this machine.
# No *.docx rule exists above, so this dir would otherwise be committable. Guard it.
data/bronze/legal_diary/

# === Legal Diary OpenView raw HTML archive — NEVER commit ===
# pdf_infra/legal_diary_openview_poller.py archives one OpenDocument HTML per sitting
# under data/bronze/legal_diary_openview/<slug>/<UNID>.html. Like the .docx archive,
# the raw HTML names PRIVATE parties AND solicitors in full — only the ANONYMISED gold
# parquet (judicial_legal_diary_openview_cases.parquet, initials only) may leave this box.
data/bronze/legal_diary_openview/

# === Raw downloaded-source staging tree — only .gitkeep belongs ===
# data/bronze/ is the raw-download staging tree for every ETL: PDFs + LA-procurement
# .aspx/.ashx blobs, scraped portal HTML (stateboards / eisb_directory SI listings /
# lrc_classlist), debate probe XML, etc. ALL of it is regenerable by re-running the
# extractors and is mirrored off-box to Cloudflare R2 (tools/backup_to_r2.ps1 +
# data/_meta/backup_manifest.tsv drift detector — see [[project_data_backup_r2]]).
# The runtime Streamlit app reads ONLY the committed gold/silver parquets, never bronze,
# so none of it needs to ship to GitHub. The type rules above miss .html and odd server
# extensions, so blanket-ignore the whole tree and keep just the .gitkeep placeholders
# that preserve the directory layout. (~25 MB of scraped HTML lived here before this rule.)
data/bronze/**
!data/bronze/**/
!data/bronze/.gitkeep
!data/bronze/**/.gitkeep

# === Member avatars (Wikidata portraits + manifest) — committed deliberately ===
# wiki_data.py downloads CC-licensed TD + Senator portraits into avatar/wikidata/.
# Streamlit Cloud boots from a fresh git clone with no ETL, so utility/ui/avatars.py
# has nothing to read unless these ship in the repo. The blanket *.jpg / *.json
# rules above swallow them; re-include the portrait set here (last match wins).
# Parent dir re-included first — git cannot un-ignore a file under an excluded dir.
!avatar/wikidata/
!avatar/wikidata/*.jpg
!avatar/wikidata/*.jpeg
!avatar/wikidata/*.png
!avatar/wikidata/*.webp
!avatar/wikidata/manifest.json

# === SQL-view test fixtures — committed deliberately ===
# test/fixtures/sql_views/_generate.py writes small synthetic parquets that let
# test/test_sql_views.py run the view-contract tests in CI without any pipeline
# output. The blanket *.parquet rule above swallows them; re-include the whole
# fixture tree (last match wins). No parent dir is ignored, so file-level
# negation is enough.
!test/fixtures/sql_views/**/*.parquet

# === AFS golden fixture — committed deliberately (test/test_afs_amalgamated.py) ===
# The 64-row amalgamated-AFS golden parquet lets the data-integrity tests run in CI
# without re-downloading the gov.ie PDFs. Page-text fixture (.txt) isn't ignored.
!test/fixtures/afs/*.parquet
# LA-payments golden slice (test/fixtures/la_payments/_generate.py) for the Tier-3 invariants
!test/fixtures/la_payments/*.parquet
# per-LA AFS golden fact (test/fixtures/la_afs/_generate.py) for test/test_la_afs.py invariants
!test/fixtures/la_afs/*.parquet
# Oireachtas API response samples — test/services/test_api_schemas.py opens them directly
# with no skip guard, so a fresh clone/CI hard-fails FileNotFoundError without them.
# The blanket *.json rule above swallows them (last match wins). ~460 KiB total.
!test/fixtures/api/*.json

# generated bulk-export snapshots (privacy-filtered copies cut by api/routers/exports.py)
data/_export_cache/

# Re-downloadable upstream archives (GTFS feeds, bulk zips) fetched by extractors.
# NEVER commit these: gtfs_all.zip alone is 165 MB and GitHub HARD-REJECTS any file
# over 100 MB, so one such blob anywhere in the pushed history fails the whole push
# and takes every other commit down with it. They are caches — refetch, don't store.
data/_cache/

# === planning_rules — per-authority Development Management Standards collection ===
# Each council dir holds markdown extracts (tracked by default) + a _source.json
# provenance file + a raw/ archive of the original HTML/PDF. The blanket *.json rule
# above swallows _source.json, so negate it (last match wins). The raw/ downloads are
# regenerable source documents — keep them ignored per the *.pdf/*.html convention.
!planning_rules/**/_source.json
planning_rules/**/raw/

# planning_rules cross-council criteria map (normalized rule values) — track these
!planning_rules/_criteria_map/*.json
!planning_rules/_criteria_map/*.csv

# planning_rules corpus seed registry (curated tracking of datasets to ingest) — track it
!planning_rules/_corpus_registry/*.csv

# CE-report lane (code, registry, corpus, reviewer decisions, recall/precision evidence)
# was consolidated 2026-08-08 into apps/public-signal/pipeline/, tracked by the
# publicsignal overlay. Nothing of it remains under pipeline_sandbox/council_minutes/.

# planning_rules application_files _text/ — OCR/extracted page-text dumps per application.
# These are large regenerable extractions (one commit added 225 files / ~340k lines) and
# don't belong in git — keep the parent application_files dir tracked, ignore the _text dumps.
planning_rules/application_files/**/_text/

# === council_minutes — raw scraped/OCR'd text corpus (pipeline_sandbox, sandbox-only) ===
# corpus/ + scratch dirs are regenerable scrape/OCR output, not source — one commit added
# 1,051 files / 216 MB (2026-08-01, see doc/SANDBOX_MAP.md). Keep the .py/.js/.md pipeline
# code and jsonl extraction outputs tracked; ignore the raw text.
pipeline_sandbox/council_minutes/corpus/
pipeline_sandbox/council_minutes/samples/
pipeline_sandbox/council_minutes/wexford_tmp/
pipeline_sandbox/council_minutes/tipperary/*.txt
pipeline_sandbox/council_minutes/*.out

# FTS probe databases (throwaway scratch DBs from sandbox search experiments, not source)
*_fts_probe.sqlite

# data/_sandbox/ — scratch dir for one-off probes (e.g. pq_fts_probe.sqlite), regenerable
data/_sandbox/

# ida/ — raw scrape cache backing the IDA sites register extraction
# (pipeline_sandbox/pq_disclosures/pq_ida_sites_register.py). All contents are
# regenerable local source material, including PDFs and derived HTML/text.
/ida/

# === editor swap + mergetool scratch files (never commit) ===
# vim/IDE swap files and 3-way merge leftovers (vimdiff/mergetool writes
# _BASE_/_LOCAL_/_REMOTE_/_BACKUP_ copies). These got committed once during a
# botched merge — keep them out for good.
*.swp
*.swo
.*.swp
*.orig
_BACKUP_*
_BASE_*
_LOCAL_*
_REMOTE_*
._*

# Second git-dir holding the private siting history (overlay repo on this worktree)
.git-siting/

# Third git-dir: PublicSignal's own private repo, split from .git-siting 2026-08-07
.git-publicsignal/

