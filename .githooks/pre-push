#!/bin/sh
# Versioned pre-push guard — blocks private siting IP / secrets from reaching the
# public remote (github.com/peweet/dail_tracker). Rules live in
# tools/check_no_private_ip.py; the CI job runs the same script.
#
# Enable on a fresh clone (one-time; core.hooksPath is local config, not cloned):
#     git config core.hooksPath .githooks
#
# This only ever BLOCKS a push; it never modifies files. CI enforces the same
# check independently, so a clone that skips the config is still covered there.

for PY in .venv/Scripts/python.exe .venv/Scripts/python .venv/bin/python python3 python; do
  command -v "$PY" >/dev/null 2>&1 && break
done

"$PY" tools/check_no_private_ip.py
status=$?
if [ "$status" -ne 0 ]; then
  echo "pre-push: private-IP guard blocked the push (see above)." >&2
  exit "$status"
fi

"$PY" tools/check_no_untracked_imports.py
status=$?
if [ "$status" -ne 0 ]; then
  echo "pre-push: tracked-import guard blocked the push (see above)." >&2
  exit "$status"
fi

# Secret scan (gitleaks, installed 2026-08-01; config .gitleaks.toml, grandfathered
# false positives in .gitleaksignore). Best-effort locally — a clone without
# gitleaks still gets the CI job. --redact: never echo a matched secret.
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks git . --redact --no-banner
  status=$?
  if [ "$status" -ne 0 ]; then
    echo "pre-push: gitleaks found a potential secret (see above; locations only, values redacted)." >&2
    exit "$status"
  fi
fi

# PublicSignal CE-lead lane: these overlay-tracked product assets were briefly committed
# to local public history (2026-08-07, since untracked). The tree check above cannot see
# HISTORY, so block any push whose outgoing commits still carry them — the push stays
# blocked until those commits are rewritten (git filter-branch --index-filter, local only).
CE_PRIVATE_PATHS="data/gold/parquet/council_ce_report_leads.parquet pipeline_sandbox/council_minutes/ce_report_lead_reviews.csv pipeline_sandbox/council_minutes/ce_lead_recall_labels.json pipeline_sandbox/council_minutes/ce_lead_recall_gap.jsonl"
ZERO=0000000000000000000000000000000000000000
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$ZERO" ] && continue  # branch deletion pushes nothing
  if [ "$remote_sha" = "$ZERO" ]; then range="$local_sha"; else range="$remote_sha..$local_sha"; fi
  # shellcheck disable=SC2086  # CE_PRIVATE_PATHS is a deliberate word-split list
  hits=$(git log --name-only --format= "$range" -- $CE_PRIVATE_PATHS 2>/dev/null | sort -u)
  if [ -n "$hits" ]; then
    echo "pre-push: outgoing commits carry PRIVATE CE-lead lane files:" >&2
    echo "$hits" | sed 's/^/  /' >&2
    echo "pre-push: rewrite the unpushed range to drop them before pushing." >&2
    exit 1
  fi
done

# Fast correctness gate (2026-08-14) -- public CI had been red for 10+ consecutive runs
# because nothing checked correctness before a push; lint + format + typecheck catch the
# recurrent classes in about a minute. Tests stay in CI (too slow for a push gate).
# Skip once with DAIL_SKIP_PUSH_GATE=1 (CI still enforces all three independently).
if [ "${DAIL_SKIP_PUSH_GATE:-0}" != "1" ]; then
  if "$PY" -m ruff --version >/dev/null 2>&1; then
    "$PY" -m ruff check . || { echo "pre-push: ruff check failed -- fix or DAIL_SKIP_PUSH_GATE=1 (CI will fail regardless)." >&2; exit 1; }
    "$PY" -m ruff format --check . || { echo "pre-push: format drift -- run ruff format on the listed files." >&2; exit 1; }
  else
    echo "pre-push: ruff not in this environment; lint gate skipped (CI enforces)." >&2
  fi
  if "$PY" -m basedpyright --version >/dev/null 2>&1; then
    "$PY" -m basedpyright || { echo "pre-push: basedpyright failed -- fix or DAIL_SKIP_PUSH_GATE=1 (CI will fail regardless)." >&2; exit 1; }
  else
    echo "pre-push: basedpyright not in this environment; type gate skipped (CI enforces)." >&2
  fi
fi
exit 0
